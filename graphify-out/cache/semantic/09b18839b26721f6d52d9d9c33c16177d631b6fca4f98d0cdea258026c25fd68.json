{"nodes": [{"id": "docs_agents_zero_allocation", "label": "Zero Object Allocation Loop Rule", "file_type": "rationale", "source_file": "docs/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never instantiate new JavaScript objects or arrays inside rendering/chunk generation loops; reuse existing typed arrays (Float32Array, Uint32Array) to avoid garbage collection pauses."}, {"id": "docs_agents_32_bit_ecs", "label": "32-Bit ECS Block Packing", "file_type": "rationale", "source_file": "docs/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contiguous Uint32Array(81920) packs texture ID, health, fluid level, isHidden, block light, and sunlight. Reuses objects to avoid overhead."}, {"id": "docs_agents_off_thread_meshing", "label": "Off-Thread Chunk Meshing", "file_type": "rationale", "source_file": "docs/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offload procedural generation and Greedy/Naive meshing to Web Workers (chunkWorker.js) to avoid blocking the main UI thread."}, {"id": "docs_agents_material_sharing_antipattern", "label": "Material Sharing Anti-Pattern Rule", "file_type": "rationale", "source_file": "docs/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not share ShaderMaterial between standard Mesh and InstancedMesh because Three.js relies on compilation macros (e.g. #define INSTANCED) that get dropped if shared, breaking instanced rendering."}, {"id": "docs_agents_host_authority", "label": "Host Supreme Authority Rule", "file_type": "rationale", "source_file": "docs/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Host executes all physical block breaking, AI, and terrain generation. Guests only send movement intents and interaction requests validated by Host anti-cheat."}, {"id": "docs_agents_diagnostics", "label": "Diagnostics & SpectorModal", "file_type": "concept", "source_file": "docs/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SpectorModal.jsx provides debugging for rendering loops, worker queues, and WebGL memory leaks."}], "edges": [{"source": "docs_agents_zero_allocation", "target": "docs_agents_32_bit_ecs", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_agents_zero_allocation", "target": "docs_agents_off_thread_meshing", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_agents_zero_allocation", "target": "docs_design_system_zero_allocation_principle", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_agents_32_bit_ecs", "target": "docs_design_system_ecs_standard_principle", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_agents_material_sharing_antipattern", "target": "docs_design_system_material_sharing_principle", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_agents_host_authority", "target": "docs_design_system_host_authority_principle", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/AGENTS.md", "source_