{
  "name": "worldsearch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ && node scripts/check_architecture.js",
    "lint:fix": "eslint src/ --fix && node scripts/check_architecture.js",
    "lint:report": "eslint src/ --format stylish",
    "preview": "vite preview",
    "prepare": "husky",
    "test:unit": "vitest run --environment jsdom",
    "test:engine": "vitest run --environment jsdom tests/engine",
    "test:godmode": "vitest run --environment jsdom tests/engine tests/ChunkWorker.test.js tests/TransitManager.test.js tests/ai-canary.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "framer-motion": "^12.40.0",
    "idb-keyval": "^6.2.4",
    "lucide-react": "^1.17.0",
    "peerjs": "^1.5.5",
    "postprocessing": "^6.39.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.2",
    "simplex-noise": "^4.0.3",
    "three": "^0.184.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
